# Plantilla .env para docker-compose.prod.yml — Producción V2.0 (branch prod-v2.0)
# Copiar en el servidor: cp .env.prod.example .env
#
# Levantar:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# Tras git pull con migraciones nuevas:
#   ./scripts/prod-migrate.sh
#
# PostgreSQL principal y bono_productividad son externos (cliente); sin contenedor de BD en Docker.

# ─── Base de Datos (PostgreSQL externo del cliente) ───────────
# docker-compose.prod.yml arma DATABASE_URL con estas variables.
# Si la contraseña tiene caracteres especiales (@, :, /, etc.), usa DATABASE_URL
# con credenciales URL-encoded en lugar de DB_PASSWORD.
DB_HOST=postgres-cliente.ejemplo.local
DB_PORT=5432
DB_NAME=leoni_rh
DB_USER=leoni
DB_PASSWORD=CAMBIAR_EN_PRODUCCION

# Alternativa: URL completa (tiene prioridad sobre DB_* en docker-compose.prod.yml)
# DATABASE_URL=postgresql+asyncpg://leoni:CAMBIAR_EN_PRODUCCION@postgres-cliente.ejemplo.local:5432/leoni_rh

# Espera de conexión al arrancar el backend (opcional)
# DB_WAIT_MAX_RETRIES=30
# DB_WAIT_DELAY_SECONDS=2

# ─── Bono productividad (PostgreSQL externo, solo lectura) ────
# Validar tras levantar:
#   docker compose -f docker-compose.prod.yml --env-file .env exec backend \
#     python -m app.scripts.check_bono_productividad_connection
BONO_DB_HOST=bono-postgres-cliente.ejemplo.local
BONO_DB_PORT=5432
BONO_DB_NAME=bono_productividad
BONO_DB_USER=bono_user
BONO_DB_PASSWORD=CAMBIAR_EN_PRODUCCION
BONO_DB_ENGINE=postgresql

# Job nocturno: calidad + seguridad + importadas + evaluación (America/Mexico_City)
BONO_CALIDAD_HISTORICO_IMPORT_ENABLED=true
BONO_CALIDAD_HISTORICO_IMPORT_CRON_HOUR=2
BONO_CALIDAD_HISTORICO_IMPORT_CRON_MINUTE=0

# Sync periódica bono.empleados → empleados
BONO_EMPLEADOS_IMPORT_ENABLED=true
BONO_EMPLEADOS_IMPORT_INTERVAL_MINUTES=30

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.leoni.com
SMTP_PORT=587
SMTP_USER=rh@leoni.com
SMTP_PASSWORD=smtp_password_aqui

# ─── Lectores de huella / terminal comedor ─────────────────────
HUELLA_WHITELIST_IPS=
COMEDOR_TERMINAL_IPS=
APP_TIMEZONE=America/Mexico_City
COMEDOR_ACCESO_HORA_INICIO=
COMEDOR_ACCESO_HORA_FIN=
TORNIQUETE_API_KEY=

# ─── IT Mirror (opcional) ─────────────────────────────────────
IT_MIRROR_DB_URL=
IT_SYNC_INTERVAL_MINUTES=30

# ─── Empleados activos (ajustar IDs reales del cliente) ───────
ESTADOS_ACTIVOS_IDS=1
ESTADOS_PERMISO_IDS=3

# ─── App ──────────────────────────────────────────────────────
APP_ENV=production
