# Plantilla .env para docker-compose.prod.yml — Producción V2.0 (branch prod-v2.0)
# Copiar en el servidor: cp .env.prod.example .env
#
# Levantar:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# Tras git pull con migraciones nuevas:
#   ./scripts/prod-migrate.sh
#
# BD única = Bono (PostgreSQL externo del cliente); sin contenedor de BD en Docker.

# ─── Base de Datos: Bono (PostgreSQL externo del cliente) ─────
# Conexión EXCLUSIVAMENTE desde este `.env` (sin contenedor de BD ni defaults
# hardcodeados). El backend arma DATABASE_URL desde las variables BONO_DB_* de abajo.
# La app usa esta misma BD como principal (tablas levelup_*, solicitudes, actas) y
# para imports históricos de solo lectura. Validar tras levantar:
#   docker compose -f docker-compose.prod.yml --env-file .env exec backend \
#     python -m app.scripts.check_bono_productividad_connection
# Si la contraseña tiene caracteres especiales (@, :, /, etc.), usa DATABASE_URL
# con credenciales URL-encoded en lugar de armarla desde BONO_DB_*.
# Alternativa: URL completa (tiene prioridad sobre BONO_DB_* en docker-compose.prod.yml)
# DATABASE_URL=postgresql+asyncpg://bono_user:CAMBIAR_EN_PRODUCCION@bono-postgres-cliente.ejemplo.local:5432/bono_productividad
BONO_DB_HOST=bono-postgres-cliente.ejemplo.local
BONO_DB_PORT=5432
BONO_DB_NAME=bono_productividad
BONO_DB_USER=bono_user
BONO_DB_PASSWORD=CAMBIAR_EN_PRODUCCION
BONO_DB_ENGINE=postgresql

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.leoni.com
SMTP_PORT=587
SMTP_USER=rh@leoni.com
SMTP_PASSWORD=smtp_password_aqui

# ─── Lectores de huella / terminal comedor ─────────────────────
HUELLA_WHITELIST_IPS=
COMEDOR_TERMINAL_IPS=
APP_TIMEZONE=America/Mexico_City
COMEDOR_ACCESO_HORA_INICIO=
COMEDOR_ACCESO_HORA_FIN=
TORNIQUETE_API_KEY=

# ─── IT Mirror (opcional) ─────────────────────────────────────
IT_MIRROR_DB_URL=

# ─── SQL Server datos-analisis (solo lectura, opcional) ───────
# BD externa de análisis, SOLO LECTURA. En prod: SQL Server remoto por host:puerto.
# Vacío = deshabilitado (el cliente devuelve None). Validar con:
#   docker-compose exec backend python -m app.scripts.check_datos_analisis_connection
DATOS_ANALISIS_DB_HOST=sqlserver-datos-analisis.ejemplo.local
DATOS_ANALISIS_DB_PORT=1433
DATOS_ANALISIS_DB_NAME=datos_analisis
DATOS_ANALISIS_DB_USER=readonly_user
DATOS_ANALISIS_DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DATOS_ANALISIS_DB_DRIVER=ODBC Driver 18 for SQL Server

# ─── Empleados activos (ajustar IDs reales del cliente) ───────
# Acepta: 1 | 1,5,7 | [1,5,7]
ESTADOS_ACTIVOS_IDS=1
ESTADOS_PERMISO_IDS=3

# ─── App ──────────────────────────────────────────────────────
APP_ENV=production

# ─── Seed inicial (./scripts/prod-seed.sh) ────────────────────
# empleado_id real de Bono.empleados para el admin RH (rol + password en levelup_empleados_core).
# SEED_ADMIN_EMPLEADO_ID=12345
# BOOTSTRAP/RECUPERACIÓN: empleado_ids que reciben `puede_administrar_permisos_rh`
# SOLO si la BD no tiene ningún administrador (al arrancar o con ./scripts/prod-seed.sh).
# NO es la fuente de permisos — la administración diaria es por la UI de RH Admin
# (levelup_empleados_permisos). Si ya hay admins, se ignora. Deben existir en `empleados`.
# SEED_RH_PERMISOS_ADMIN_EMPLEADO_IDS=12345,67890
