# Plantilla .env para docker-compose.prod.yml — Producción V1.0
# Copiar a .env en el servidor: cp .env.prod.example .env
#
# V1.0 no usa Ollama, TRESS ni torniquete. Esas variables viven solo en
# .env.example (desarrollo / integraciones futuras).

# ─── Base de Datos ────────────────────────────────────────────
POSTGRES_DB=leoni_rh
POSTGRES_USER=leoni
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.leoni.com
SMTP_PORT=587
SMTP_USER=rh@leoni.com
SMTP_PASSWORD=smtp_password_aqui

# ─── Lectores de huella / terminal comedor ─────────────────────
# IPs separadas por coma. En producción definir las IPs reales del comedor.
HUELLA_WHITELIST_IPS=
COMEDOR_TERMINAL_IPS=
APP_TIMEZONE=America/Mexico_City
COMEDOR_ACCESO_HORA_INICIO=
COMEDOR_ACCESO_HORA_FIN=

# ─── IT Mirror (opcional) ─────────────────────────────────────
IT_MIRROR_DB_URL=
IT_SYNC_INTERVAL_MINUTES=30

# ─── App ──────────────────────────────────────────────────────
APP_ENV=production
