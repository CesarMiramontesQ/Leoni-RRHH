# ─── Base de Datos ────────────────────────────────────────────
# BD única = Bono (PostgreSQL externo del cliente). No hay contenedor de BD en Docker
# ni valores de conexión por defecto: TODO viene de este `.env`. Si faltan, el backend
# falla al arrancar con un mensaje claro.
# El backend arma DATABASE_URL desde BONO_DB_* (abajo). DATABASE_URL explícita es
# override OPCIONAL (úsala si la contraseña trae caracteres especiales @ : /):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD_URLENCODED@HOST:PORT/bono_productividad

# ─── Bono productividad (PostgreSQL externo, BD principal) ────
# OBLIGATORIO: define host/puerto/BD/usuario/contraseña reales de tu servidor PostgreSQL.
# Copia este bloque a `.env` (raíz del repo) con usuario/contraseña reales y reinicia backend:
#   docker-compose up -d backend
# Validar: docker-compose exec backend python -m app.scripts.check_bono_productividad_connection
# Importar histórico bono → incidencias (simulación / ejecución):
#   python -m app.scripts.import_calidad_historico
#   python -m app.scripts.import_calidad_historico --execute
#   python -m app.scripts.import_seguridad_historico
#   python -m app.scripts.import_seguridad_historico --execute
#   python -m app.scripts.import_importadas_historico
#   python -m app.scripts.import_importadas_historico --execute
#   python -m app.scripts.import_evaluacion_historica_gral
#   python -m app.scripts.import_evaluacion_historica_gral --execute
# Sincronización empleados bono (manual):
#   python -m app.scripts.import_empleados_bono
#   python -m app.scripts.import_empleados_bono --execute
BONO_DB_HOST=host.docker.internal
BONO_DB_PORT=5433
BONO_DB_NAME=bono_productividad
BONO_DB_USER=bono_user
BONO_DB_PASSWORD=cambiar_por_password_real
BONO_DB_ENGINE=postgresql

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.leoni.com
SMTP_PORT=587
SMTP_USER=rh@leoni.com
SMTP_PASSWORD=smtp_password_aqui

# ─── Ollama LLM (IA Local) ────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_ACTA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.3
# Tokens de contexto (entrada+salida en ventana). Subir si Ollama loguea "truncating input prompt" con actas+RAG.
# OLLAMA_NUM_CTX=16384
# Modelo local para embeddings del RAG legal.
# OLLAMA_EMBED_MODEL=nomic-embed-text
# RAG legal (LFT + Reglamento Interior). Reindexar tras cambiar fuentes.
# LEGAL_RAG_CHROMA_PATH=storage/legal-rag-chroma
# LEGAL_RAG_CHUNK_SIZE=1000
# LEGAL_RAG_CHUNK_OVERLAP=200
# LEGAL_RAG_TOP_K=24
# LEGAL_RAG_SCORE_THRESHOLD=0.45
# LEGAL_RAG_SNIPPET_MAX_CHARS=1600
# LEGAL_REFERENCE_PROMPT_MAX_CHARS=15000

# ─── Lectores de Huella ───────────────────────────────────────
# IPs separadas por coma. Vacío = permite todas (solo para desarrollo)
HUELLA_WHITELIST_IPS=

# ─── Terminal comedor (login usuario/contraseña en red del comedor) ──
# Si vacío, se reutiliza HUELLA_WHITELIST_IPS. Vacío en ambos = permite todas (dev)
COMEDOR_TERMINAL_IPS=
APP_TIMEZONE=America/Mexico_City
# Ventana opcional 24h (ej. 06:30 y 15:00). Vacío = sin límite horario
COMEDOR_ACCESO_HORA_INICIO=
COMEDOR_ACCESO_HORA_FIN=
# Si se define, los POST /terminal/* exigen header X-Torniquete-Key con este valor
TORNIQUETE_API_KEY=


# ─── TRESS SQL Server (solo lectura, Windows) ─────────────────
TRESS_ODBC_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=tress-server;DATABASE=TRESS;UID=readonly_user;PWD=password

# ─── SQL Server datos-analisis (solo lectura, on-demand) ──────
# BD externa de análisis, SOLO LECTURA. En dev corre como contenedor Docker; en prod
# es un SQL Server remoto por host:puerto. Si HOST/NAME/USER están vacíos, el cliente
# devuelve None y no afecta el arranque.
# Validar: docker-compose exec backend python -m app.scripts.check_datos_analisis_connection
# HOST: si el SQL Server comparte red Docker con el backend usa el NOMBRE DEL SERVICIO;
#       si expone su puerto al host, usa host.docker.internal + el puerto publicado.
# PORT: usa el puerto PUBLICADO por el contenedor SQL Server al host (p. ej. 14333),
# no el 1433 interno, porque backend y SQL Server no comparten red Docker.
DATOS_ANALISIS_DB_HOST=host.docker.internal
DATOS_ANALISIS_DB_PORT=14333
DATOS_ANALISIS_DB_NAME=datos_analisis
# Usuario con lectura (saldos) y escritura (INSERT vacaciones al aprobar)
DATOS_ANALISIS_DB_USER=tress_app_user
DATOS_ANALISIS_DB_PASSWORD=cambiar_por_password_real
DATOS_ANALISIS_DB_DRIVER=ODBC Driver 18 for SQL Server
# Segundos para ESTABLECER la conexion (no para ejecutar consultas). El default
# del driver son 15 s: con TRESS caido, cada peticion que lo toque se cuelga ese
# tiempo y el dashboard del empleado se queda esperando.
DATOS_ANALISIS_DB_CONNECT_TIMEOUT=5

# Ventana (en semanas) que relee el sync de incidencias de los miercoles 10:00.
SYNC_INCIDENCIAS_TRESS_SEMANAS=8

# Vacaciones → TRESS al aprobar (INSERT dbo.VACACION)
TRESS_VACACIONES_NOM_TIPO=1
TRESS_VACACIONES_US_CODIGO=49
# true = ejecuta validaciones/insert y hace ROLLBACK (staging)
TRESS_VACACIONES_DRY_RUN=false
# Home office → TRESS al aprobar (INSERT dbo.PERMISO; usa TRESS_VACACIONES_US_CODIGO)
TRESS_HOME_OFFICE_DRY_RUN=false
# Suspensión → TRESS al registrar en faltas/retardos (INSERT dbo.PERMISO; usa TRESS_VACACIONES_US_CODIGO)
TRESS_SUSPENSION_DRY_RUN=false

# Permiso con goce (matrimonio/defunción/paternidad) → dbo.PERMISO FJ
TRESS_GOCE_DRY_RUN=false

# ─── IT Mirror ────────────────────────────────────────────────
IT_MIRROR_DB_URL=postgresql+asyncpg://it_user:password@it-server:5432/it_db

# ─── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Seed / bootstrap administradores de permisos RH ──────────
# BOOTSTRAP/RECUPERACIÓN únicamente: empleado_ids (separados por coma) a los que se
# les otorga `puede_administrar_permisos_rh` SOLO cuando la BD no tiene ningún admin
# (al arrancar o vía `python -m app.utils.seed`). NO es la fuente de permisos: la
# administración diaria se hace desde RH Admin (UI) y vive en levelup_empleados_permisos.
# Si ya hay admins, esta variable se ignora. Deben existir en `empleados` (Bono).
SEED_RH_PERMISOS_ADMIN_EMPLEADO_IDS=9999,9998
