# ─── Base de Datos ────────────────────────────────────────────
# Estas 3 variables las usa docker-compose.prod.yml para crear el contenedor de Postgres
POSTGRES_DB=leoni_rh
POSTGRES_USER=leoni
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION

# El backend arma DATABASE_URL automáticamente en docker-compose; solo necesitas esta variable si corres fuera de Docker
DATABASE_URL=postgresql+asyncpg://leoni:leoni_dev_pass@localhost:5432/leoni_rh

# ─── Bono productividad (PostgreSQL externo, solo lectura) ────
# En desarrollo con Docker, los valores por defecto van en `docker-compose.yml` (backend);
# no hace falta un `.env` en tu PC. Validar: docker-compose exec backend python -m app.scripts.check_bono_productividad_connection
# Este bloque comentado solo aplica si corres el backend fuera de Docker.
# BONO_DB_HOST=localhost
# BONO_DB_PORT=5433
# BONO_DB_NAME=bono_productividad
# BONO_DB_USER=bono_user
# BONO_DB_PASSWORD=bono_password
# BONO_DB_ENGINE=postgresql

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.leoni.com
SMTP_PORT=587
SMTP_USER=rh@leoni.com
SMTP_PASSWORD=smtp_password_aqui

# ─── Ollama LLM (IA Local) ────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_ACTA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.3
# Tokens de contexto (entrada+salida en ventana). Subir si Ollama loguea "truncating input prompt" con actas+RAG.
# OLLAMA_NUM_CTX=16384
# Modelo local para embeddings del RAG legal.
# OLLAMA_EMBED_MODEL=nomic-embed-text
# RAG legal (LFT + Reglamento Interior). Reindexar tras cambiar fuentes.
# LEGAL_RAG_CHROMA_PATH=storage/legal-rag-chroma
# LEGAL_RAG_CHUNK_SIZE=1000
# LEGAL_RAG_CHUNK_OVERLAP=200
# LEGAL_RAG_TOP_K=24
# LEGAL_RAG_SCORE_THRESHOLD=0.45
# LEGAL_RAG_SNIPPET_MAX_CHARS=1600
# LEGAL_REFERENCE_PROMPT_MAX_CHARS=15000

# ─── Lectores de Huella ───────────────────────────────────────
# IPs separadas por coma. Vacío = permite todas (solo para desarrollo)
HUELLA_WHITELIST_IPS=

# ─── Terminal comedor (login usuario/contraseña en red del comedor) ──
# Si vacío, se reutiliza HUELLA_WHITELIST_IPS. Vacío en ambos = permite todas (dev)
COMEDOR_TERMINAL_IPS=
APP_TIMEZONE=America/Mexico_City
# Ventana opcional 24h (ej. 06:30 y 15:00). Vacío = sin límite horario
COMEDOR_ACCESO_HORA_INICIO=
COMEDOR_ACCESO_HORA_FIN=
# Si se define, los POST /terminal/* exigen header X-Torniquete-Key con este valor
TORNIQUETE_API_KEY=


# ─── TRESS SQL Server (solo lectura, Windows) ─────────────────
TRESS_ODBC_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=tress-server;DATABASE=TRESS;UID=readonly_user;PWD=password

# ─── IT Mirror ────────────────────────────────────────────────
IT_MIRROR_DB_URL=postgresql+asyncpg://it_user:password@it-server:5432/it_db
IT_SYNC_INTERVAL_MINUTES=30

# ─── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
